function OnShowQuest()
	NumberData.UseDBString = 1
	local state = NumberData.Log2

	NumberData.QuestBtn_Visible = 1
	StringData.QuestBtn_Path = "Quest/Quest_2010_01_26_List"

	NumberData.IsSystemQuest = 1
	StringData.QuestName = "WelcomeToBnB_QuestName"	--"초보자 퀘스트"
	
	NumberData.Back_Visible = 1
	
	if state >= FinalState	-- 마지막 화면 출력
	then
		StringData.Back_Path = "Quest/Quest_2010_01_26_Back09"		
		return 0	
	else					-- 진행 배경 화면 출력
		StringData.Back_Path = "Quest/Quest_2010_01_26_Back01"
	end	
	
	-- 메시지 출력
	if StateTable[state] == StateTypeMission 			
	then
		local msgCount = 0
		
		for k, v in ipairs(MissionString[state]) do
			local style = string.format("Msg%02d_Style", msgCount)
			local textColor = string.format("Msg%02d_TextColor", msgCount)
			local posX = string.format("Msg%02d_PosX", msgCount)
			local posY = string.format("Msg%02d_PosY", msgCount)
			local content = string.format("Msg%02d_Content", msgCount)
			local height = string.format("Msg%02d_Height", msgCount)

			NumberData[style] = v.fontType
			NumberData[textColor] = v.fontColor
			NumberData[posX] = v.x
			NumberData[posY] = v.y
			NumberData[height] = 14
			StringData[content] = v.msg
								
			msgCount = msgCount + 1				-- 메시지 갯수 증가		
		end
				
		-- 현재 남은 게임수를 계산하여 출력
		if (state == MissionStateIndex[4]) or (state == MissionStateIndex[5]) or (state == MissionStateIndex[6]) 
		then
			local style = string.format("Msg%02d_Style", msgCount)
			local textColor = string.format("Msg%02d_TextColor", msgCount)
			local posX = string.format("Msg%02d_PosX", msgCount)
			local posY = string.format("Msg%02d_PosY", msgCount)
			local content = string.format("Msg%02d_Content", msgCount)
			
			NumberData[style] = 3
			NumberData[textColor] = ColorBlue
			NumberData[posX] = 181
			NumberData[posY] = 347
			StringData[content] = ""..(CompleteGameCount - NumberData.Log3)		-- 남은 게임수 계산
			
			msgCount = msgCount + 1						
		end				
		
		NumberData.Msg_Count = msgCount			
	else
		NumberData.Msg_Count = 1		
		NumberData.Msg00_Style = 0
		NumberData.Msg00_TextColor = GetColor(98, 35, 0)
		NumberData.Msg00_OutlineColor = 0
		NumberData.Msg00_PosX = 50
		NumberData.Msg00_PosY = 305
		NumberData.Msg00_Height = 14
		StringData.Msg00_Content = NormalString[state]		
	end		
		
		
	-- 이미지 출력
   	local imgInfo = InformationImgInfo[state]	
	if imgInfo					-- 추가 정보 이미지가 있으면
	then	
		-- 배경 변경
		StringData.Back_Path = imgInfo.path					   	
   	else						-- 추가 정보 이미지가 없으면   	
   		-- 미션별 완료 이미지 출력	
		local imgCount = 0	
		for index, imgIndex in ipairs(CompleteImgIdx) do
			if imgIndex > state 
			then
				break;
			end			
			
			local path = string.format("Img%02d_Path", imgCount)
			local frame = string.format("Img%02d_Frame", imgCount)
			local posX = string.format("Img%02d_PosX", imgCount)
			local posY = string.format("Img%02d_PosY", imgCount)
			
			StringData[path] = CompleteImgInfo[imgIndex].path
			NumberData[frame] = 0
			NumberData[posX] = CompleteImgInfo[imgIndex].x
			NumberData[posY] = CompleteImgInfo[imgIndex].y
			imgCount = imgCount + 1		
		end	   	   	
   	   	
   		NumberData.Img_Count = imgCount  
   		
   		if MapBtnInfo[state] == nil
   		then
   			NumberData.AniImg_Count = 1	
	  	  		
			NumberData.AniImg00_Frame = 0	
			NumberData.AniImg00_PosX = 0
			NumberData.AniImg00_PosY = 0
			NumberData.AniImg00_Total = 2			
			NumberData.AniImg00_Delay = 10
			StringData.AniImg00_Path = ""   			
   		
   			-- 미션 버튼이 활성화 되있지 않은 상태이면 
   			-- 애니 이미지 출력
	   		if (MapBtnIdx[1] < state) and (CompleteImgIdx[1] > state)
	   		then
	   			StringData.AniImg00_Path = AniImgInfo[1].path
	   			NumberData.AniImg00_PosX = AniImgInfo[1].x
				NumberData.AniImg00_PosY = AniImgInfo[1].y	   		
	   		elseif (MapBtnIdx[2] < state) and (CompleteImgIdx[2] > state)
	   		then 
	   			StringData.AniImg00_Path = AniImgInfo[2].path
	   			NumberData.AniImg00_PosX = AniImgInfo[2].x
				NumberData.AniImg00_PosY = AniImgInfo[2].y
	   		elseif (MapBtnIdx[3] < state) and (CompleteImgIdx[3] > state)
	   		then 
	   			StringData.AniImg00_Path = AniImgInfo[3].path
	   			NumberData.AniImg00_PosX = AniImgInfo[3].x
				NumberData.AniImg00_PosY = AniImgInfo[3].y
	   		elseif (MapBtnIdx[4] < state) and (CompleteImgIdx[4] > state)
	   		then 
	   			StringData.AniImg00_Path = AniImgInfo[4].path
	   			NumberData.AniImg00_PosX = AniImgInfo[4].x
				NumberData.AniImg00_PosY = AniImgInfo[4].y	   		
	   		elseif (MapBtnIdx[5] < state) and (CompleteImgIdx[5] > state)
	   		then 
	   			StringData.AniImg00_Path = AniImgInfo[5].path
	   			NumberData.AniImg00_PosX = AniImgInfo[5].x
				NumberData.AniImg00_PosY = AniImgInfo[5].y	   		
	   		end   		
   		end   		 	
   	end	
   	
   	if MapBtnInfo[state] ~= nil 
   	then
   		-- 버튼 활성화 시킬 상태이면
   		if state == MissionStateIndex[2]		-- 혼자하기 입장 ( QuickJoin 버튼 )
		then
			NumberData.QuickJoinBtn_Visible = 1
			NumberData.QuickJoinBtn_GameType = 15 			
			NumberData.QuickJoinBtn_PosX = MapBtnInfo[state].x
			NumberData.QuickJoinBtn_PosY = MapBtnInfo[state].y			
			StringData.QuickJoinBtn_Path = MapBtnInfo[state].path	
		else
			NumberData.DoneBtn_Count = 1
			NumberData.DoneBtn00_Visible = 1
			NumberData.DoneBtn00_PosX = MapBtnInfo[state].x
			NumberData.DoneBtn00_PosY = MapBtnInfo[state].y
			StringData.DoneBtn00_Path = MapBtnInfo[state].path			
		end   		   		
   	elseif StateTable[state] ~= StateTypeMission
   	then
   		-- 미션 상태가 아니면 ( 다음 버튼 )
   		NumberData.DoneBtn_Count = 1
		NumberData.DoneBtn00_Visible = 1
		NumberData.DoneBtn00_PosX = NextBtnInfo.x
		NumberData.DoneBtn00_PosY = NextBtnInfo.y
		StringData.DoneBtn00_Path = NextBtnInfo.path   	
   	end 
   	
	return 0
end


function GetNumInPos ( num, pos )
	--
	numTemp = math.floor (num / pos)
	numInPos = 0
	if numTemp ~= 0
	then
		numInPos = numTemp - math.floor ( numTemp / 10 ) * 10
	end
	return numInPos
end

function GetColor(red, green, blue)
	color = (red * 65536) + (green * 256) + blue
	return color
end
